# Адрес API не задаём жёстко: приложение само берёт IP компьютера из Metro
# (см. src/lib/config.ts) и добавляет порт 5001. Жёсткий IP ломает вход,
# как только Мак оказывается в другой сети.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.148:5001
# EXPO_PUBLIC_API_BASE_URL=https://chef-api.airesidence.kz
