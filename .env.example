# ============================================
# Chef Mobile App — Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values.

# API Base URL (your backend server)
# For Expo Go dev: leave empty to auto-detect from hostUri
# For production: set your real API domain
# EXPO_PUBLIC_API_BASE_URL=https://chef-api.yourdomain.com
API_BASE_URL=http://localhost:5000
